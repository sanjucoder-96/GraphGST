# Copy to `.env` and fill in real values. NEVER commit the real .env.

# ── Neo4j ──────────────────────────────────────────────────────────
# For local docker-compose: bolt://neo4j:7687
# For Aura:                 neo4j+s://<your-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please

# ── API security ───────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Random long secret required to hit destructive endpoints
# (POST /api/seed?force=true, DELETE /api/seed, POST /api/datagen/load).
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── Regional defaults (used only in narrative templates) ──────────
DISTRICT_CODE=KA
