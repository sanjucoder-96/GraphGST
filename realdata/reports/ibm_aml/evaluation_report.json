    "license": "CDLA-Sharing-1.0 (commercial OK, share-alike)",
    "description": "IBM AMLworld HI-Small: a published, labelled directed payment graph (Altman et al., NeurIPS 2023). Directed From\u2192To account transfers with timestamps, amounts, and a per-transaction Is-Laundering label whose typologies include a 'simple cycle' (ground-truth circular trading).",
    "is_real_taxpayer_data": false,
    "anonymized": false,
    "notes": "Deterministic sample of AMLworld HI-Small: scanned 5,078,345 source rows; kept ALL 5,177 laundering txns + every 40th normal txn (126,818 kept) = 131,995 transactions, 144,107 accounts. Realistic SYNTHETIC AML benchmark, NOT real taxpayer data; 'laundering' is a documented analog of GST circular trading."
  },
  "feature_availability": [
    {
      "feature": "Reconciliation (GSTR-1\u21942B\u21943B, ITC)",
      "required_fields": "GSTR filings + tax amounts",
      "available": false,
      "can_run": "NO",
      "reason": "requires GSTR-1/2B/3B filing rows the source does not provide"
    },
    {
      "feature": "ITC-mismatch detection",
      "required_fields": "invoice tax vs claimed ITC",
      "available": false,
      "can_run": "NO",
      "reason": "needs statutory tax amounts and filed returns"
    },
    {
      "feature": "Ring / circular-trade detection",
      "required_fields": "directed supplier\u2192buyer edges",
      "available": true,
      "can_run": "YES",
      "reason": "the core graph capability; runs on the edge list"
    },
    {
      "feature": "GSTIN / entity relationships",
      "required_fields": "entities + edges",
      "available": true,
      "can_run": "YES",
      "reason": "neighbourhood + community structure"
    },
    {
      "feature": "Temporal analysis",
      "required_fields": "per-transaction dates",
      "available": true,
      "can_run": "YES",
      "reason": "runs on transaction timestamps"
    },
    {
      "feature": "Risk scoring (composed)",
      "required_fields": "ring + temporal (+ reconcile/rules if filings)",
      "available": true,
      "can_run": "PARTIAL",
      "reason": "ring + temporal scorers fire; reconcile/rules contribute ~0 without filing/status data"
    },
    {
      "feature": "Graph embeddings (structural)",
      "required_fields": "graph structure",
      "available": true,
      "can_run": "YES",
      "reason": "node2vec/PMI-SVD over the real graph"
    },
    {
      "feature": "Ground-truth evaluation (precision/recall)",
      "required_fields": "fraud/ring labels",
      "available": true,
      "can_run": "YES",
      "reason": "labels present \u2192 supervised eval"
    }
  ],
