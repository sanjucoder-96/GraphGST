# Repo-root ignores. Project-specific rules follow below.

# Loose archives (e.g. the old gst_v5_upgraded.zip snapshot)
*.zip

# Tool caches
.pytest_cache/

# Local editor / tool state
.claude/
__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
*.pkl
node_modules/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Generated datasets — never commit synthetic output
datagen_output/
datagen_output*/
*.parquet
truth.json

# IDE
.vscode/
.idea/
*.swp

# Trained embedding artifacts — regenerated by refresh_intelligence / demo.reset
embed_artifacts/

# Runtime feedback log (written by POST /api/agent/feedback) — never commit
feedback.jsonl

# Loose archives (e.g. vendored upgrade zips) — never commit
*.zip

# Real-data raw downloads + regenerable canonical CSVs (reports ARE kept).
# Raw public datasets are large and/or licence-restricted — never commit them.
realdata/raw/
realdata/reports/*/*.csv

# Large derived CSVs from real-data runs (regenerable, may contain real identifiers)
realdata/reports/**/*.csv
